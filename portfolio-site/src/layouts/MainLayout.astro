          display: flex;
          justify-content: flex-start;
        }
      }

      @media (max-width: 520px) {
        .nav {
          padding: 0.85rem 1rem;
        }

        .brand {
          white-space: normal;
          line-height: 1.3;
        }

        .nav-links {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 0.35rem;
