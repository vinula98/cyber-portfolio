          gap: 0.7rem;
        }

        .nav-toggle {
          display: inline-flex;
          margin-left: auto;
        }

        .nav-links {
          width: 100%;
          max-height: 0;
          overflow: hidden;
          opacity: 0;
          pointer-events: none;
          transform: translateY(-4px);
          transition: max-height 0.22s ease, opacity 0.18s ease, transform 0.18s ease;
        }

