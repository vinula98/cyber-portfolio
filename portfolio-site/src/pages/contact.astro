---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Contact | Vinula Kasthuriarachchi"
  description="Contact Vinula Kasthuriarachchi for cybersecurity opportunities, graduate programs, networking, or collaboration."
>
  <section class="contact-hero-panel">
    <h1>Let's Connect</h1>

    <p>
      Open to cybersecurity graduate roles, security operations opportunities,
      infrastructure security work, and professional networking.
    </p>
  </section>

  <section class="contact-grid contact-grid-primary" aria-label="Primary contact options">
    <article class="contact-card contact-card-primary">
      <h2 class="has-icon contact-heading">
        <span class="contact-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
          </svg>
        </span>
        Email
      </h2>
      <p>
        <a href="mailto:vinulakas.98@gmail.com">vinulakas.98@gmail.com</a>
      </p>

      <a class="btn btn-primary" href="mailto:vinulakas.98@gmail.com">
        Send Email
      </a>
    </article>

    <article class="contact-card">
      <h2 class="has-icon contact-heading">
        <span class="contact-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M6.94 8.98H3.56V20h3.38V8.98ZM5.25 4C4.16 4 3.3 4.8 3.3 5.82c0 1.04.86 1.84 1.95 1.84s1.95-.8 1.95-1.84C7.2 4.8 6.34 4 5.25 4ZM20.7 13.67c0-3.16-1.69-4.98-4.25-4.98-1.78 0-2.72.98-3.19 1.66V8.98H9.88V20h3.38v-5.82c0-1.55.74-2.47 2-2.47 1.17 0 1.73.84 1.73 2.47V20h3.38v-6.33h.33Z" />
          </svg>
        </span>
        LinkedIn
      </h2>
      <p>
        Professional profile, experience history, and networking.
      </p>

      <a class="btn btn-secondary" href="https://www.linkedin.com/in/vinula-kasthuriarachchi-7b3130154" target="_blank" rel="noreferrer">
        Connect
      </a>
    </article>

    <article class="contact-card">
      <h2 class="has-icon contact-heading">
        <span class="contact-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2.25A9.76 9.76 0 0 0 8.91 21.27c.49.09.67-.21.67-.47v-1.69c-2.73.6-3.31-1.17-3.31-1.17-.45-1.14-1.09-1.44-1.09-1.44-.89-.61.07-.6.07-.6.98.07 1.5 1.01 1.5 1.01.88 1.5 2.3 1.07 2.86.82.09-.64.34-1.07.62-1.32-2.18-.25-4.47-1.09-4.47-4.85 0-1.07.38-1.94 1-2.63-.1-.25-.44-1.25.1-2.6 0 0 .82-.26 2.68 1 .78-.22 1.62-.33 2.46-.33.84 0 1.68.11 2.46.33 1.86-1.26 2.68-1 2.68-1 .54 1.35.2 2.35.1 2.6.63.69 1 1.56 1 2.63 0 3.77-2.3 4.59-4.49 4.84.35.31.66.91.66 1.83v2.57c0 .26.18.57.68.47A9.76 9.76 0 0 0 12 2.25Z" />
          </svg>
        </span>
        GitHub
      </h2>
      <p>
        Projects, code, and technical portfolio activity.
      </p>

      <a class="btn btn-secondary" href="https://github.com/vinula98" target="_blank" rel="noreferrer">
        View Profile
      </a>
    </article>
  </section>

  <section class="contact-grid contact-details-grid" aria-label="Location and mobile details">
    <article class="contact-card">
      <h2 class="has-icon contact-heading">
        <span class="contact-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.35 1.9.66 2.81a2 2 0 0 1-.45 2.11L8.05 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.31 1.85.53 2.81.66A2 2 0 0 1 22 16.92Z" />
